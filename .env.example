# ── Firebase (브라우저에 노출되어도 되는 값입니다. 보안은 Firestore 규칙이 담당합니다) ──
VITE_FB_API_KEY=여기에_붙여넣기
VITE_FB_AUTH_DOMAIN=프로젝트id.firebaseapp.com
VITE_FB_PROJECT_ID=프로젝트id
VITE_FB_STORAGE_BUCKET=프로젝트id.appspot.com
VITE_FB_SENDER_ID=123456789012
VITE_FB_APP_ID=1:123456789012:web:abcdef123456

# ── Google AI Studio (Gemini). VITE_ 접두사를 붙이면 키가 노출되니 절대 붙이지 마세요 ──
GEMINI_API_KEY=여기에_AI_STUDIO_키_붙여넣기
GEMINI_MODEL=gemini-3.5-flash-lite
